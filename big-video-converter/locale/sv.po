# converter/constants.py, line: 255
msgid "Crop the video's edges to keep only the part you need."
msgstr "Beskär videons kanter för att behålla endast den del du behöver."

# File: big-video-converter/big-video-converter/usr/share/big-video-
# converter/constants.py, line: 276
msgid ""
"Select parts of the video to keep.\n"
"\n"
"Add sections with the + button or directly in the video using the markers button above the video.\n"
"\n"
"You can export selected parts as one file or as multiple clips\n"
" ideal for creating short videos for social media."
msgstr ""
"Välj delar av videon att behålla.\n"
"\n"
"Lägg till sektioner med +-knappen eller direkt i videon med markörknappen ovanför videon.\n"
"\n"
"Du kan exportera valda delar som en fil eller som flera klipp, vilket är idealiskt för att skapa korta videor för sociala medier."

# File: big-video-converter/big-video-converter/usr/share/big-video-
# converter/constants.py, line: 282
msgid ""
"Run decode on the CPU and encode on the GPU.\n"
"\n"
"Usually best left disabled, but can help with certain compatibility issues."
msgstr ""
"Kör avkodning på CPU:n och kodning på GPU:n.\n"
"\n"
"Vanligtvis bäst att lämna inaktiverat, men kan hjälpa med vissa kompatibilitetsproblem."

# File: big-video-converter/big-video-converter/usr/share/big-video-
# converter/constants.py, line: 286
msgid ""
"Audio quality:\n"
"\n"
"• Higher = better quality, larger file\n"
"• 128k: Good for most content\n"
"• 192k: High quality\n"
"• 256k+: Professional use\n"
"• Default: Auto (encoder decides)"
msgstr ""
"Ljudkvalitet:\n"
"\n"
"• Högre = bättre kvalitet, större fil\n"
"• 128k: Bra för det mesta innehållet\n"
"• 192k: Hög kvalitet\n"
"• 256k+: Professionellt bruk\n"
"• Standard: Auto (kodaren bestämmer)"

# File: big-video-converter/big-video-converter/usr/share/big-video-
# converter/constants.py, line: 294
msgid ""
"Number of audio channels:\n"
"\n"
"• 1: Mono (single speaker)\n"
"• 2: Stereo (left/right)\n"
"• 6: 5.1 Surround\n"
"• 8: 7.1 Surround\n"
"• Default: Keep original"
msgstr ""
"Antal ljudkanaler:\n"
"\n"
"• 1: Mono (en högtalare)\n"
"• 2: Stereo (vänster/höger)\n"
"• 6: 5.1 Surround\n"
"• 8: 7.1 Surround\n"
"• Standard: Behåll original"

# File: big-video-converter/big-video-converter/usr/share/big-video-
# converter/constants.py, line: 302
msgid ""
"Advanced: Custom FFmpeg options.\n"
"\n"
"• For experienced users only\n"
"• Invalid options may cause errors\n"
"• Example: -ss 60 -t 30 (skip 60s, take 30s)"
msgstr ""
"Avancerat: Anpassade FFmpeg-alternativ.\n"
"\n"
"• Endast för erfarna användare\n"
"• Ogiltiga alternativ kan orsaka fel\n"
"• Exempel: -ss 60 -t 30 (hoppa över 60s, ta 30s)"

# File: big-video-converter/big-video-converter/usr/share/big-video-
# converter/constants.py, line: 273
msgid "Skips all remaining processes and just exports the embedded subtitles as an SRT file."
msgstr "Hoppar över alla återstående processer och exporterar bara de inbäddade undertexterna som en SRT-fil."

msgid ""
"Reduces background noise from speech with a neural network.\n"
"\n"
"• Requires audio re-encoding\n"
"• Works best for constant background noise\n"
"• Automatically re-encodes audio if set to copy"
msgstr ""
"Minskar bakgrundsbrus i tal med hjälp av ett neuronnätverk.\n"
"\n"
"• Kräver ljudomkodning\n"
"• Fungerar bäst för konstant bakgrundsbrus\n"
"• Omkodar automatiskt ljudet om det är inställt på kopiera"

# File: big-video-converter/big-video-converter/usr/share/big-video-
# converter/constants.py, line: 327
msgid ""
"Adjust the intensity of noise reduction\n"
"\n"
"• 1.0: Maximum reduction (default)\n"
"• 0.5: Moderate reduction\n"
"• Lower values preserve more original audio"
msgstr ""
"Justera intensiteten av brusreducering\n"
"\n"
"• 1.0: Maximal reduktion (standard)\n"
"• 0.5: Måttlig reduktion\n"
"• Lägre värden bevarar mer av det ursprungliga ljudet"

# File: big-video-converter/big-video-converter/usr/share/big-video-
# converter/constants.py, line: 333
msgid ""
"Noise gate silences audio below a volume threshold\n"
"\n"
"Useful combined with noise reduction to eliminate\n"
"residual noise during pauses between speech.\n"
"\n"
"Adjust intensity from low to maximum."
msgstr ""
"Brusshanter tystar ljud under en volymtröskel\n"
"\n"
"Användbar i kombination med brusreducering för att eliminera\n"
"återstående brus under pauser mellan tal.\n"
"\n"
"Justera intensiteten från låg till maximal."

# File: big-video-converter/big-video-converter/usr/share/big-video-
# converter/constants.py, line: 325
