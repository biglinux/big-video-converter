msgid "Convert Video Formats"
msgstr "Пераўтварэнне фарматаў відэа"

msgid ""
"MP4, MKV, AVI, WebM and many more\n"
"with hardware acceleration support"
msgstr ""
"MP4, MKV, AVI, WebM і шмат іншых\n"
