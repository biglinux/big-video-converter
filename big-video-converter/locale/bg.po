# converter/constants.py, line: 321
#: big-video-converter/usr/share/big-video-converter/constants.py:327
msgid ""
"Reduces background noise from audio using the GTCRN neural network.\n"
"\n"
"• Requires audio re-encoding\n"
"• Works best for constant background noise\n"
"• Automatically re-encodes audio if set to copy"
msgstr ""
"Намалява фоновия шум от аудио с помощта на невронната мрежа GTCRN.\n"
"\n"
"• Изисква повторно кодиране на аудиото\n"
"• Работи най-добре при постоянен фонов шум\n"
"• Автоматично повторно кодира аудиото, ако е настроено на копиране"

# File: big-video-converter/big-video-converter/usr/share/big-video-
# converter/constants.py, line: 327
#: big-video-converter/usr/share/big-video-converter/constants.py:333
msgid ""
"Adjust the intensity of noise reduction\n"
"\n"
"• 1.0: Maximum reduction (default)\n"
"• 0.5: Moderate reduction\n"
"• Lower values preserve more original audio"
msgstr ""
"Настройте интензивността на намаляване на шума\n"
"\n"
"• 1.0: Максимално намаляване (по подразбиране)\n"
"• 0.5: Умерено намаляване\n"
"• По-ниски стойности запазват повече оригинален звук"

# File: big-video-converter/big-video-converter/usr/share/big-video-
# converter/constants.py, line: 333
#: big-video-converter/usr/share/big-video-converter/constants.py:339
msgid ""
"Noise gate silences audio below a volume threshold\n"
"\n"
"Useful combined with noise reduction to eliminate\n"
"residual noise during pauses between speech.\n"
"\n"
"Adjust intensity from low to maximum."
msgstr ""
"Шумовата врата заглушава аудио под прага на звука\n"
"\n"
"Полезно в комбинация с намаляване на шума за елиминиране\n"
"на остатъчния шум по време на паузи между речта.\n"
"\n"
"Настройте интензивността от ниска до максимална."

# File: big-video-converter/big-video-converter/usr/share/big-video-
# converter/constants.py, line: 339
#: big-video-converter/usr/share/big-video-converter/constants.py:345
msgid ""
"Voice Recovery — high-frequency reconstruction\n"
"\n"
"Recovers frequencies above 8 kHz that the AI\n"
"noise reduction model removes.\n"
"\n"
"• 0%: Cuts all HF (maximum NR)\n"
"• 75%: Natural default\n"
"• 100%: Full original HF preserved"
msgstr ""
"Възстановяване на глас — реконструкция на високи честоти\n"
"\n"
"Възстановява честоти над 8 kHz, които моделът за намаляване на шума с ИИ премахва.\n"
"\n"
"• 0%: Премахва всички ВЧ (максимално намаляване на шума)\n"
"• 75%: Естествено по подразбиране\n"
"• 100%: Пълно запазване на оригиналните ВЧ"

