msgstr ""
"• Nach rechts bewegen: Heller\n"
"• Nach links bewegen: Dunkler\n"
"• Standard: 0 (keine Änderung)"

msgid ""
"• Move right: More vivid\n"
"• Move left: More muted\n"
"• Default: 0% (no change)"
msgstr ""

