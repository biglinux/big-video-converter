"• Move right: Brighter\n"
"• Move left: Darker\n"
"• Default: 0 (no change)"
msgstr ""
"• Beweeg naar rechts: Heldere\n"
"• Beweeg naar links: Donkerder\n"
"• Standaard: 0 (geen verandering)"

msgid ""
"• Move right: More vivid\n"
"• Move left: More muted\n"
"• Default: 0% (no change)"
msgstr ""

