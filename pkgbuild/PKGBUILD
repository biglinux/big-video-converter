# Maintainer: Tales A. Mendonça <talesam@gmail.com>

pkgname=big-video-converter
pkgdesc="Video converter and editor with GTK4 and FFmpeg"
depends=('python>=3.11' 'python-gobject' 'gtk4' 'ffmpeg' 'python-cairo' 'python-mpv' 'libadwaita>=1.5' 'libva-utils' 'python-opengl' 'vte4')
makedepends=('git' 'gettext' 'desktop-file-utils' 'appstream')
optdepends=('deepfilternet3-native: light AI noise reduction for speech (DeepFilterNet3)'
            'dpdfnet-native: higher-quality AI noise reduction for speech (DPDFNet-2 48 kHz)'
            'nautilus-python: Load the Nautilus context menu extension'
            'libnautilus-extension: Nautilus API used by the context menu extension')
conflicts=('comm-video-converter')
replaces=('comm-video-converter')
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('MIT')
url="https://github.com/biglinux/$pkgname"
# big-gtk-kit's Python module (MIT) ships inside this package, from its main.
_gtk_kit="big-gtk-kit::git+https://github.com/biglinux/big-gtk-kit.git#branch=main"
# Inside a checkout this recipe builds its working tree, uncommitted changes
# included. GitLab's chroot receives only this directory and fetches from
# GitHub instead; keep that line literal, the builder appends #branch= to it.
_recipe_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)
_checkout=${_recipe_dir%/*}
if [ -e "${_checkout}/.git" ] && [ -d "${_checkout}/${pkgname}/usr" ]; then
    source=("${_gtk_kit}")
    sha256sums=('SKIP')
else
    _checkout=
    source=("git+${url}.git"
            "${_gtk_kit}")
    sha256sums=('SKIP' 'SKIP')
fi

# Automatically detect and use the correct install file
if [ -e "${pkgname}.install" ]; then
    install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
    install=pkgbuild.install
fi

prepare() {
    [ -n "${_checkout}" ] || return 0
    # The files git sees: tracked and new ones, without ignored output or this
    # recipe's own src/ and pkg/.
    rm -rf "${srcdir:?}/${pkgname}"
    mkdir "${srcdir}/${pkgname}"
    git -C "${_checkout}" ls-files -z --cached --others --exclude-standard \
        -- ":!:${_recipe_dir#"${_checkout}"/}" |
        tar -C "${_checkout}" --null --files-from=- --ignore-failed-read -cf - |
        tar -C "${srcdir}/${pkgname}" -xf -
}

build() {
    cd "${srcdir}/${pkgname}"
    bash tools/compile-translations.sh
}

check() {
    cd "${srcdir}/${pkgname}"
    desktop-file-validate big-video-converter/usr/share/applications/*.desktop
    appstreamcli validate --no-net big-video-converter/usr/share/metainfo/*.xml
}

package() {
    cd "${srcdir}/${pkgname}"

    cp -a big-video-converter/usr "${pkgdir}/"
    # -L: the kit links its stylesheet from the Rust half.
    cp -rL "${srcdir}/big-gtk-kit/python/big_gtk_kit" "${pkgdir}/usr/share/big-video-converter/"
    install -Dm644 "${srcdir}/big-gtk-kit/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.big-gtk-kit"
    printf '%s\n' "${pkgver}-${pkgrel}" > "${pkgdir}/usr/share/big-video-converter/VERSION"

    # Install license file if present
    if [ -f "LICENSE" ]; then
        install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi

    # Install documentation if present
    if [ -f "README.md" ]; then
        install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
        install -Dm644 docs/screenshot.png "${pkgdir}/usr/share/doc/${pkgname}/docs/screenshot.png"
    fi
}
